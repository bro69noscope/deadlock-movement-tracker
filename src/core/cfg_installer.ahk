#Include paths.ahk
#Include debug.ahk

EnsureCfgInstalled() {
  outPath := MVTRACK_CFG_EXEC_PATH
  txt := GetPosToolsCfgText()
  SPlitPath outPath, &fileName

  if FileExist(outPath) {
    try {
      existing := FileRead(outPath)
      if (existing = txt) {
        Debug(A_ThisFunc ": " fileName " already up-to-date at " outPath)
        return true
      }
    } catch as e {
      Debug(A_ThisFunc ": couldn't read existing cfg: " e.Message)
    }
  }

  try {
    tmp := outPath ".tmp"
    try FileDelete(tmp)

    FileAppend(txt, tmp, "UTF-8-RAW")

    try FileDelete(outPath)
    FileMove(tmp, outPath, 1)

    Debug(A_ThisFunc ": wrote " outPath)
    return true
  } catch as e {
    err := "Message: " e.Message "`nWhat: " e.What "`nStack:`n" e.Stack
    Debug(A_ThisFunc ": FAILED`n" err)
    MsgBox(
      "Write failed.`n`n"
      . outPath "`n`n"
      . e.Message,
      "Movement Tracker",
      0x30
    )
    return false
  }

}

GetPosToolsCfgText() {
  return
  (
    "// GENERATED by the deadlock-movement-tracker script from Bro`n"
    "// Thanks to ProStoKrut for original idea and Leif for discovery`n"

    "`n"

    "// Necessary aliases definition first`n"
    "alias train_team_amber "
    "changeteam 2; alias train_team_toggle train_team_sapphire" "`n"

    "alias train_team_sapphire "
    "changeteam 3; alias train_team_toggle train_team_amber" "`n"

    "alias train_team_toggle " "train_team_sapphire" "`n"
    "alias train_start " "spawn_hero_testing_controller" "`n"

    "`n"

    "// User key bindings`n"
    "bind " "" CFG.noclip "" " " "noclip" "`n"
    "bind " "" CFG.load_practice_map "" " " "map dl_midtown" "`n"
    "bind " "" CFG.swap_team "" " " "train_team_toggle" "`n"
    "bind " "" CFG.setup_practice "" " " "train_start" "`n"
    "bind " "" CFG.enable_fast_stamina "" " " "citadel_enable_fast_stamina" "`n"
    "bind " "" CFG.disable_fast_stamina "" " " "citadel_disable_fast_stamina" "`n"

    "bind " "" CFG.set_host_timescale_fast "" " " "host_timescale "
    CFG.host_timescale_factor "" "`n"

    "bind " "" CFG.set_host_timescale_normal "" " " "host_timescale 1" "`n"

    "`n"

    "// Used programmatically by deadlock-movement-tracker only`n"
    "bind " "" CFG.mvtrack_mark_pos "" " " "getpos_exact" "`n"
    "bind " "" CFG.mvtrack_teleport "" " " "exec mvtrack_pos.cfg" "`n"
    "bind " "" CFG.mvtrack_teleport_temp "" " " "exec mvtrack_pos_temp.cfg" "`n"
    "bind " "" CFG.mvtrack_set_timescale "" " " "exec mvtrack_timescale.cfg" "`n"

  )
}
