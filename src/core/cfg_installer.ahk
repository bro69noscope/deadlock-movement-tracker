#Include paths.ahk
#Include debug.ahk

EnsureCfgInstalled() {
  outPath := MVTRACK_CFG_EXEC_PATH
  txt := GetPosToolsCfgText()
  SPlitPath outPath, &fileName

  if FileExist(outPath) {
    try {
      existing := FileRead(outPath)
      if existing = txt {
        Debug(A_ThisFunc ": " fileName " already up-to-date at " outPath)
        return true
      }

    } catch as e {
      Debug(A_ThisFunc ": couldn't read existing cfg: " e.Message)
    }
  }

  try {
    tmp := outPath ".tmp"
    try FileDelete(tmp)

    FileAppend(txt, tmp, "UTF-8-RAW")

    try FileDelete(outPath)
    FileMove(tmp, outPath, 1)

    Debug(A_ThisFunc ": wrote " outPath)
    return true

  } catch as e {
    err := "Message: " e.Message "`nWhat: " e.What "`nStack:`n" e.Stack
    Debug(A_ThisFunc ": FAILED`n" err)
    MsgBox(
      "Write failed.`n`n"
      outPath "`n`n"
      e.Message,
      "Movement Tracker",
      0x30
    )
    return false
  }

}

GetPosToolsCfgText() {
  practice :=
    "sv_cheats 1;"
    . " citadel_hero_testing_enabled 1;"
    . " citadel_coop_sandbox 1;"
    . " citadel_hero_testing_infinite_money 1;"
    . " citadel_allow_purchasing_anywhere 1;"
    . " citadel_crate_respawn_interval 0;"
    . " citadel_allow_duplicate_heroes 1;"
  ; . " ai_disable"

  return
  (
    "// GENERATED by the deadlock-movement-tracker script from Bro`n"
    "// Thanks to ProStoKrut for original idea and Leif for discovery`n`n"

    "// Necessary aliases definition first`n"
    "alias team_amber " Chr(34)
    "changeteam 2; alias team_toggle team_sapphire" Chr(34) "`n"

    "alias team_sapphire " Chr(34)
    "changeteam 3; alias team_toggle team_amber" Chr(34) "`n"

    "alias team_toggle team_sapphire`n`n"

    "alias setup_practice " Chr(34) practice Chr(34) "`n`n"

    "// User key bindings`n"
    "bind " "" CFG.noclip "" " " "noclip" "`n"
    "bind " "" CFG.load_practice_map "" " " "map dl_midtown" "`n"
    "bind " "" CFG.swap_team "" " " "team_toggle" "`n"
    "bind " "" CFG.setup_practice "" " " "setup_practice" "`n"
    "bind " "" CFG.enable_fast_stamina "" " " "citadel_rapid_stamina_regen 1" "`n"
    "bind " "" CFG.disable_fast_stamina "" " " "citadel_rapid_stamina_regen 0" "`n"
    "bind " "" CFG.enable_fast_cooldowns "" " " "citadel_ability_cooldown_max 1" "`n"
    "bind " "" CFG.disable_fast_cooldowns "" " " "citadel_ability_cooldown_max 0" "`n"

    "bind " "" CFG.set_host_timescale_fast "" " " "host_timescale "
    CFG.host_timescale_factor "" "`n"

    "bind " "" CFG.set_host_timescale_normal "" " " "host_timescale 1" "`n"

    "`n"

    "// Used programmatically by deadlock-movement-tracker only`n"
    "bind " "" CFG.mvtrack_mark_pos "" " " "getpos_exact" "`n"
    "bind " "" CFG.mvtrack_teleport "" " " "exec mvtrack_pos.cfg" "`n"
    "bind " "" CFG.mvtrack_teleport_temp "" " " "exec mvtrack_pos_temp.cfg" "`n"
    "bind " "" CFG.mvtrack_set_timescale "" " " "exec mvtrack_timescale.cfg" "`n"

  )
}
