#Include paths.ahk
#Include debug.ahk

EnsurePs1Installed() {
  outPath := DEADLOCK_ROOT "\dl-move-tracker.ps1"
  txt := GetPoswatchScriptText()
  SplitPath outPath, &fileName

  ; If already exists with same content, do nothing
  if FileExist(outPath) {
    try {
      existing := FileRead(outPath)
      if (existing = txt) {
        Debug(A_ThisFunc ": " fileName " already up-to-date at " outPath)
        return true
      }
    } catch as e {
      Debug(A_ThisFunc ": couldn't read existing ps1: " e.Message)
    }
  }

  try {
    tmp := outPath ".tmp"
    try FileDelete(tmp)

    FileAppend(txt, tmp, "UTF-8-RAW")

    try FileDelete(outPath)
    FileMove(tmp, outPath, 1)

    Debug(A_ThisFunc ": wrote " outPath)
    return true
  } catch as e {
    err := ""
    try err := "Message: " e.Message "`nWhat: " e.What "`nExtra: " e.Extra "`nFile: " e.File "`nLine: " e.Line
    Debug(A_ThisFunc ": FAILED`n" err)
    MsgBox(
      "Write failed.`n`n"
      . outPath "`n`n"
      . err,
      "Movement Tracker",
      0x30
    )
    return false
  }
}

GetPoswatchScriptText() {
  return "
(
# GENERATED by the deadlock-movement-tracker script from Bro
# Thanks to ProStoKrut for original idea and Leif
# Watches console.log and writes game\citadel\cfg\lastpos.cfg whenever it sees setpos_exact

$GameRoot = Get-Location
$Log  = Join-Path $GameRoot 'game\citadel\console.log'
$Out  = Join-Path $GameRoot 'game\citadel\cfg\lastpos.cfg'

$pat = 'setpos_exact ([\s0-9.-]*);'

if (-not (Test-Path $Out)) {
  Set-Content -Path $Out -Value 'setpos 0 0 0' -Encoding Ascii
}

Get-Content -Path $Log -Wait | ForEach-Object {
  $m = [regex]::Match($_, $pat)
  if ($m.Success) {
    $s = $m.Value.Remove(0,12)
    Set-Content -Path $Out -Value ('setpos ' + $s) -Encoding Ascii
  }
}
)"
}
