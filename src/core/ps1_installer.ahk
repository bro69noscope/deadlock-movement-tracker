#Include debug.ahk

EnsurePs1Installed() {
  outPath := MVTRACK_PS1_PATH
  txt := GetPoswatchScriptText()
  SplitPath outPath, &fileName

  if FileExist(outPath) {

    try {
      existing := FileRead(outPath)
      if existing = txt {
        Debug(A_ThisFunc ": " fileName " already up-to-date at " outPath)
        return true
      }

    } catch as e {
      Debug(A_ThisFunc ": couldn't read existing ps1: " e.Message)
    }
  }

  try {
    tmp := outPath ".tmp"
    try FileDelete(tmp)

    FileAppend(txt, tmp, "UTF-8-RAW")

    try FileDelete(outPath)
    FileMove(tmp, outPath, 1)

    Debug(A_ThisFunc ": wrote " outPath)
    return true

  } catch as e {
    err := "Message: " e.Message "`nWhat: " e.What "`nStack:`n" e.Stack
    Debug(A_ThisFunc ": FAILED`n" err)

    MsgBox(
      "Write failed.`n`n"
      outPath "`n`n"
      e.Message,
      "Movement Tracker",
      0x30
    )
    return false
  }
}

GetPoswatchScriptText() {
  return "
(
# GENERATED by the deadlock-movement-tracker script from Bro
# Thanks to ProStoKrut for original idea and Leif for discovery
param(
  [Parameter(Mandatory=$true)]
  [string]$GameRoot,

  [Parameter(Mandatory=$true)]
  [string]$OutPath,

  [Parameter(Mandatory=$true)]
  [string]$LogFile)

$Log = Join-Path $GameRoot 'game\citadel\console.log'
$Out = $OutPath

function Log($msg) {
  $ts = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
  Add-Content -Path $LogFile -Value "$ts | $msg"
}

Log 'Poswatch started. Watching ' + $Log

$pat = 'setpos_exact ([\s0-9.-]*);'

if (-not (Test-Path $Out)) {
  Set-Content -Path $Out -Value 'setpos 0 0 0' -Encoding Ascii
}

try {
  Get-Content -Path $Log -Wait | ForEach-Object {
    $m = [regex]::Match($_, $pat)
    if ($m.Success) {
      $s = $m.Value.Substring(12).Trim().TrimEnd(';')
      Set-Content -Path $Out -Value ("setpos $s") -Encoding Ascii
      Log ('wrote ' + $s + ' in ' + $Out)
    }
  }
} catch {
  Log "ERROR: $($_.Exception.Message)"
  throw
}
)"
}
